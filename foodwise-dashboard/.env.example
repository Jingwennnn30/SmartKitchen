# AWS Lambda HTTP API Configuration
# Replace with your actual HTTP API Gateway URL after deployment

# Example: https://abc123def4.execute-api.us-east-1.amazonaws.com
REACT_APP_LAMBDA_API_URL=https://your-api-id.execute-api.region.amazonaws.com

# Other existing environment variables
REACT_APP_API_URL=https://your-api-endpoint.com/api