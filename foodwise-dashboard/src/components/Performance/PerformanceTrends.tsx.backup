                        <Box>
                            <Typography variant="h5" sx={{ fontWeight: 'bold', mb: 0.5, color: '#1f2937' }}>
                                Performance Analytics
                            </Typography>
                            <Typography variant="body2" sx={{ color: '#6b7280' }}>
